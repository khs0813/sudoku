---
import { type Locale, getLocalizedPath, getSiteConfig } from '../config';

interface Props {
  locale?: Locale;
}

const { locale = 'ko' } = Astro.props;
const siteConfig = getSiteConfig(locale);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <strong>{siteConfig.name}</strong>
        <p>{siteConfig.description} {siteConfig.labels.footerExtra}</p>
      </div>
      <nav class="footer-links" aria-label={siteConfig.labels.footerNav}>
        <a href={getLocalizedPath('/about/', locale)}>{siteConfig.labels.about}</a>
        <a href={getLocalizedPath('/contact/', locale)}>{siteConfig.labels.contact}</a>
        <a href={getLocalizedPath('/privacy/', locale)}>{siteConfig.labels.privacy}</a>
        <a href="/robots.txt">robots.txt</a>
        <button class="button small secondary" type="button" data-install hidden>{siteConfig.labels.install}</button>
      </nav>
    </div>
    <div class="footer-bottom">© {year} {siteConfig.name}. {siteConfig.labels.footerBottom}</div>
  </div>
</footer>
