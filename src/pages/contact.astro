---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
import { getSeoPage } from '../seo';

const seo = getSeoPage('/contact/');
---
<BaseLayout title={seo.title} description={seo.description}>
  <section class="page-head">
    <div class="shell prose">
      <nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span>›</span><span>광고문의</span></nav>
      <h1>광고문의</h1>
      <p>{siteConfig.name} 서비스 내 광고 집행, 배너 노출 및 제휴 문의 안내입니다.</p>
    </div>
  </section>

  <section class="section compact">
    <div class="shell prose content-card">
      <h2>배너 광고 및 제휴 문의</h2>
      <p>스도쿠데이 서비스 내 광고 배너 노출, 제휴 제안, 기타 서비스 관련 문의는 아래 메일 주소로 보내주시기 바랍니다.</p>
      
      <div class="contact-box">
        <div class="contact-email">
          <span class="email-label">이메일 주소:</span>
          <a href={`mailto:${siteConfig.contactEmail}`} class="email-link" id="contact-email">{siteConfig.contactEmail}</a>
        </div>
        <div class="contact-actions">
          <a href={`mailto:${siteConfig.contactEmail}`} class="button primary small">메일 보내기</a>
          <button type="button" class="button secondary small" id="copy-email-btn" data-email={siteConfig.contactEmail}>이메일 주소 복사</button>
        </div>
      </div>

      <h2>문의 시 참고 사항</h2>
      <ul>
        <li>희망하시는 광고 유형(상단 배너, 하단 배너 등) 및 희망 게재 기간을 함께 기재해 주시면 보다 빠른 안내가 가능합니다.</li>
        <li>보내주신 문의는 확인 후 영업일 기준 1~2일 이내에 답변드립니다.</li>
      </ul>
    </div>
  </section>

  <script>
    const copyBtn = document.getElementById('copy-email-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email');
        if (!email) return;
        try {
          await navigator.clipboard.writeText(email);
          const originalText = copyBtn.textContent;
          copyBtn.textContent = '복사되었습니다!';
          setTimeout(() => {
            copyBtn.textContent = originalText;
          }, 2000);
        } catch {
          alert(`이메일 주소: ${email}`);
        }
      });
    }
  </script>
</BaseLayout>
