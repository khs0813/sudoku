---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Locale, getSiteConfig, siteLocales } from '../config';
import { getSeoAlternates, getXDefaultPath } from '../seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  locale?: Locale;
}

const { title, description, canonical, image = '/og-default.png', type = 'website', jsonLd, noindex = false, locale = 'ko' } = Astro.props;
const localizedConfig = getSiteConfig(locale);
const site = Astro.site ?? new URL(localizedConfig.fallbackUrl);
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site);
const imageUrl = new URL(image, site);
const alternateLinks = getSeoAlternates(canonical ?? Astro.url.pathname);
const englishPath = alternateLinks.find((item) => item.locale === 'en')?.path ?? '';
const koreanPath = alternateLinks.find((item) => item.locale === 'ko')?.path ?? '';
const xDefaultPath = getXDefaultPath(canonical ?? Astro.url.pathname);
const manifestHref = locale === 'en' ? '/en/manifest.webmanifest' : '/manifest.webmanifest';
const rssHref = locale === 'en' ? '/en/rss.xml' : '/rss.xml';
const alternateOgLocale = locale === 'en' ? siteLocales.ko.ogLocale : siteLocales.en.ogLocale;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const naverVerification = import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION || '49e2450b6593446c4a4559d2a524b6a6c05496ef';
const gaId = import.meta.env.PUBLIC_GA_ID;
const baseJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: localizedConfig.name,
    alternateName: localizedConfig.shortName,
    url: new URL(locale === 'en' ? '/en/' : '/', site).href,
    description: localizedConfig.description,
    inLanguage: localizedConfig.language
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: localizedConfig.name,
    description: localizedConfig.description,
    url: canonicalUrl.href,
    genre: localizedConfig.genre,
    playMode: 'SinglePlayer',
    gamePlatform: ['Web Browser', 'Mobile Web'],
    inLanguage: localizedConfig.language,
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: localizedConfig.priceCurrency }
  }
];
const structured = [...baseJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---
<!doctype html>
<html lang={localizedConfig.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={localizedConfig.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={localizedConfig.shortName} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href={manifestHref} />
    {alternateLinks.map((item) => <link rel="alternate" hreflang={item.hreflang} href={new URL(item.path, site)} />)}
    {alternateLinks.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(xDefaultPath, site)} />}
    <link rel="alternate" type="application/rss+xml" title={`${localizedConfig.name} RSS`} href={new URL(rssHref, site)} />
    <meta property="og:locale" content={localizedConfig.ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={localizedConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {naverVerification && <meta name="naver-site-verification" content={naverVerification} />}
    {structured.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    {gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>}
    {gaId && <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId, { anonymize_ip: true });
    </script>}
    <script is:inline define:vars={{ currentLocale: locale, englishPath, koreanPath }}>
      (() => {
        const storageKey = 'sudokuday:locale';
        const userAgent = navigator.userAgent || '';
        const isCrawler = /bot|crawl|spider|slurp|bingpreview|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot/i.test(userAgent);
        if (isCrawler) return;

        let savedLocale = '';
        try {
          savedLocale = localStorage.getItem(storageKey) || '';
        } catch {
          savedLocale = '';
        }

        const languages = Array.isArray(navigator.languages) && navigator.languages.length ? navigator.languages : [navigator.language || ''];
        const prefersKorean = languages.some((language) => /^ko\b/i.test(language));
        const wantsEnglish = savedLocale === 'en' || (!savedLocale && !prefersKorean);
        const wantsKorean = savedLocale === 'ko';
        const targetPath = currentLocale === 'ko' && wantsEnglish ? englishPath : currentLocale === 'en' && wantsKorean ? koreanPath : '';

        if (targetPath && targetPath !== location.pathname) {
          location.replace(`${targetPath}${location.search}${location.hash}`);
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{localizedConfig.labels.skipLink}</a>
    <Header currentPath={Astro.url.pathname} locale={locale} />
    <main id="main"><slot /></main>
    <Footer locale={locale} />
    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <script src="/app-shell.js" defer></script>
  </body>
</html>
